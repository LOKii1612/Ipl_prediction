# IPL Cricket Prediction Bot — Environment Variables

# ── Core ──────────────────────────────────────────────
MODEL_DIR=./models
DATA_DIR=./data
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ── Authentication (optional — leave blank for open access) ──
API_KEY=

# ── CORS ──────────────────────────────────────────────
CORS_ORIGINS=*

# ── Redis Cache (optional — leave blank to disable) ──
REDIS_URL=
CACHE_TTL=300

# ── Deployment ────────────────────────────────────────
APP_ENV=development
WORKERS=1
